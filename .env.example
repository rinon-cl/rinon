# RINON 2.0 — safe defaults. Copy to an environment-specific secret store.
# False/blank is intentional: preview must not silently become production.

# Public release / SEO
RINON_INDEXABLE=false
RINON_ENABLE_MIGRATION_REDIRECTS=false
RINON_ENABLE_BLOG_REDIRECTS=false
# Set true only after full live crawl + GSC reconciliation against docs/URL-MIGRATION-INVENTORY.md.
RINON_URL_INVENTORY_COMPLETE=false

# Capability launches
RINON_POWDER_COATING_LAUNCH_ENABLED=false
RINON_GRANALLADO_LAUNCH_ENABLED=false
RINON_ALLOW_LEGACY_REFERENCE_IMAGES=false

# Leads / analytics
RINON_LEAD_WRITE_ENABLED=false
# Preview writes require this second explicit gate; leave false outside controlled integration tests.
RINON_ALLOW_PREVIEW_WRITES=false
RINON_WRITE_ALLOWED_ORIGIN=https://rinon.cl
RINON_ABUSE_PROTECTION_APPROVED=false
RINON_PRODUCTION_TRACKING_ENABLED=false
RINON_ANALYTICS_ALLOW_PREVIEW=false
# GA4: production-only, loaded after analytics consent. Optional override of G-CLSKZ2P8CJ.
# This does not enable internal analytics, GTM or Clarity.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=lCFMIIVsso0tKtwMRjnZWQs1l2FbYnlJPWpqxsqjj_Y
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# Public contact confirmed for this release (can still be overridden by environment)
NEXT_PUBLIC_RINON_WHATSAPP_NUMBER=56975893742
NEXT_PUBLIC_RINON_PHONE_DISPLAY=+56 9 7589 3742
NEXT_PUBLIC_RINON_PUBLIC_ADDRESS=Portezuelo 1506
NEXT_PUBLIC_RINON_PUBLIC_LOCALITY=San Bernardo

# Legal identity — required before legal pages can be indexable
RINON_LEGAL_APPROVED=false
NEXT_PUBLIC_RINON_LEGAL_ENTITY=Tolipoli SpA
NEXT_PUBLIC_RINON_LEGAL_TAX_ID=77.795.508-K
NEXT_PUBLIC_RINON_LEGAL_REPRESENTATIVE=
NEXT_PUBLIC_RINON_LEGAL_ADDRESS=
NEXT_PUBLIC_RINON_PRIVACY_EMAIL=

# Existing private admin dashboard
RINON_ADMIN_ENABLED=false
ADMIN_PASSWORD=

# Privacy-rights request channel (separate from sales leads)
RINON_PRIVACY_WRITE_ENABLED=false

# Revenue Ops tables/admin. Enable only after applying reviewed migration and smoke test.
RINON_REVENUE_OPS_ENABLED=false
