# RINON 2.0 — safe review-preview profile
# No indexing, no production writes, no live tracking, no redirects.
RINON_INDEXABLE=false
RINON_ENABLE_MIGRATION_REDIRECTS=false
RINON_ENABLE_BLOG_REDIRECTS=false
# Cutover gate: keep false until full live crawl + GSC reconciliation is completed.
RINON_URL_INVENTORY_COMPLETE=false
RINON_LEAD_WRITE_ENABLED=false
# Keep false for normal review. Set true only for a controlled integration test together with RINON_LEAD_WRITE_ENABLED=true.
RINON_ALLOW_PREVIEW_WRITES=false
RINON_WRITE_ALLOWED_ORIGIN=https://rinon.cl
RINON_ABUSE_PROTECTION_APPROVED=false
RINON_PRODUCTION_TRACKING_ENABLED=false
RINON_ANALYTICS_ALLOW_PREVIEW=false

# Current-site product/reference imagery is owner-approved for review use.
# This does NOT authorize client/project attribution.
RINON_ALLOW_LEGACY_REFERENCE_IMAGES=false

# Capability-sensitive services stay closed until operational approval.
RINON_POWDER_COATING_LAUNCH_ENABLED=false
RINON_GRANALLADO_LAUNCH_ENABLED=false

