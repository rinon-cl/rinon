{
  "name": "rinon-v2-staging",
  "version": "1.0.0-rc.7",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/reconstruct-visual-assets.mjs",
    "preflight:production": "node scripts/preflight-production.mjs",
    "build": "npm run qa:migration && npm run qa:seo-cro && npm run qa:visual-provenance && npm run qa:brand-assets && npm run qa:attachments && npm run qa:crm && npm run qa:analytics && npm run qa:legal && npm run preflight:production && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "qa:migration": "node scripts/check-migration-contract.mjs",
    "qa:seo-cro": "node scripts/check-seo-cro-contract.mjs",
    "qa:visual-provenance": "node scripts/check-visual-provenance.mjs",
    "qa:attachments": "node scripts/check-quote-attachments.mjs",
    "qa:crm": "node scripts/check-lead-structure.mjs",
    "qa:analytics": "node scripts/check-analytics-contract.mjs",
    "qa:legal": "node scripts/check-legal-contract.mjs",
    "qa:sync-artifacts": "node scripts/check-sync-artifacts.mjs",
    "qa:brand-assets": "node scripts/check-brand-assets.mjs",
    "qa:brand-assets:render": "node scripts/check-brand-assets-render.mjs",
    "qa:browser-contract": "node scripts/check-browser-qa-contract.mjs",
    "qa:static": "npm run qa:sync-artifacts && npm run typecheck && npm run qa:migration && npm run qa:seo-cro && npm run qa:visual-provenance && npm run qa:attachments && npm run qa:crm && npm run qa:analytics && npm run qa:legal && npm run qa:brand-assets && npm run qa:brand-assets:render && npm run qa:browser-contract && npm run preflight:production",
    "qa:served": "node scripts/check-served-build.mjs",
    "qa:remote": "node scripts/check-served-build.mjs",
    "qa:browser:remote": "node scripts/check-remote-target.mjs && playwright test",
    "preqa:browser": "npm run prebuild",
    "qa:browser": "playwright test",
    "check:release": "npm run qa:static && npm run build && npm run qa:served && npm run qa:browser"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
